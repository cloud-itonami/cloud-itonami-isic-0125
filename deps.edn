{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace (transferred + renamed from
 ;; com-junkawasaki/langgraph-clj / com-junkawasaki/langchain-clj).
 ;;
 ;; This tree/bush-fruit-and-nut-growing vertical is SELF-CONTAINED: there
 ;; is no `kotoba-lang/orchard-growing` to delegate orchard-registration /
 ;; cost-threshold / closed-op-allowlist checks to, so those pure functions
 ;; live in `berrynutops.registry` / `berrynutops.facts` rather than
 ;; wrapping an external lib. This repo is standalone (forkable outside the
 ;; workspace); the :local/root path only resolves inside the monorepo
 ;; checkout -- a standalone fork should override it with git coordinates
 ;; (see `io.github.kotoba-lang/langgraph`'s own `deps.edn`, which pins
 ;; `langchain` via `:git/sha` for exactly this reason).
 ;;
 ;; FIX (this commit): the real dependency was previously ONLY declared
 ;; under the unused `:dev :override-deps` alias -- `:deps` was `{}`, so
 ;; a plain `clojure -M:test`/`clojure -M:run` never had `langgraph.graph`
 ;; on the classpath at all. It now lives in the main `:deps` map, the
 ;; path every alias actually resolves against (mirrors
 ;; cloud-itonami-isic-1101's `distilling` deps.edn / cloud-itonami-isic-869's
 ;; `transportops` deps.edn, the same fix applied to the same pattern).
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "berrynutops.sim"]}
  ;; clojure -M:dev:render-html -> regenerate docs/samples/operator-console.html (flagship item 2, ADR-2607189300 Wave5).
  :render-html {:main-opts ["-m" "berrynutops.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
